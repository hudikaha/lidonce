#!/bin/sh
set -eu

case "${1:-status}" in
  status)
    /usr/bin/pmset -g | /usr/bin/awk '/SleepDisabled/ { print $2; found=1 } END { if (!found) print "unknown" }'
    ;;
  reset|off)
    /usr/bin/sudo -n /usr/bin/pmset -a disablesleep 0
    ;;
  open)
    /usr/bin/open "$HOME/Applications/LidOnce.app"
    ;;
  *)
    echo "usage: lidonce [status|reset|open]" >&2
    exit 2
    ;;
esac

